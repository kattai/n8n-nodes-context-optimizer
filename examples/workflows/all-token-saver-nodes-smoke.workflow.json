                                         "language":  "javaScript",
                                         "jsCode":  "const output = String($input.first().json.output || \u0027\u0027);\nconst expected = $(\u0027Gerar Base JSON\u0027).first().json.expected;\nconst normalized = output.normalize(\u0027NFD\u0027).replace(/[\\u0300-\\u036f]/g, \u0027\u0027).toLowerCase();\nconst exactFacts = [expected.lead, expected.city, expected.capital, expected.meeting, String(expected.approved)];\nconst factsPreserved = exactFacts.every((fact) =\u003e normalized.includes(String(fact).normalize(\u0027NFD\u0027).replace(/[\\u0300-\\u036f]/g, \u0027\u0027).toLowerCase()));\nconst contentSavings = $(\u0027Token Saver Content — JSON\u0027).first().json.tokenSavings;\nconst analyzedSavings = $(\u0027Token Savings — Conteúdo\u0027).first().json.tokenSavings;\nconst store = $(\u0027Token Saver Store — Original\u0027).first().json;\nconst report = [\n  \u0027## Smoke test dos cinco nodes\u0027,\n  \u0027**Token Saver Content:** \u0027 + contentSavings.before + \u0027 → \u0027 + contentSavings.after + \u0027 (\u0027 + contentSavings.percent + \u0027%)\u0027,\n  \u0027**Token Savings:** \u0027 + analyzedSavings.saved + \u0027 tokens estimados economizados\u0027,\n  \u0027**Token Saver Store:** recurso \u0027 + store.resourceId + \u0027, original não devolvido na saída\u0027,\n  \u0027**Token Saver Retriever:** registro exato recuperado pelo agente\u0027,\n  \u0027**Token Saver Chat Model:** chamada concluída com Gemini 2.5 Flash\u0027,\n  \u0027**5/5 fatos preservados:** \u0027 + (factsPreserved ? \u0027sim\u0027 : \u0027não\u0027),\n  \u0027\u0027,\n  output\n].join(\u0027\\n\u0027);\nreturn [{ json: {\n  output: report,\n  passed: factsPreserved \u0026\u0026 Boolean(store.stored) \u0026\u0026 contentSavings.saved \u003e 0,\n  nodes_tested: [\u0027Token Saver Content\u0027, \u0027Token Savings\u0027, \u0027Token Saver Store\u0027, \u0027Token Saver Chat Model\u0027, \u0027Token Saver Retriever\u0027],\n  content_savings: contentSavings,\n  resource_id: store.resourceId,\n  original_leaked_by_simple_outputs: Object.hasOwn($(\u0027Token Saver Content — JSON\u0027).first().json, \u0027content\u0027) || Object.hasOwn(store, \u0027content\u0027),\n  retrieved_output: output,\n  facts_preserved: factsPreserved\n} }];"
                                     },
