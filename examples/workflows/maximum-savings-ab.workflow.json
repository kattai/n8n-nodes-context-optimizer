                      "parameters":  {
                                         "mode":  "runOnceForAllItems",
                                         "language":  "javaScript",
                                         "jsCode":  "const comparison = $input.first().json;\nconst savings = comparison.tokenSavings || {};\nconst telemetry = comparison.modelTelemetry || {};\nconst optimization = telemetry.optimized?.optimization || {};\nconst baseline = String($(\u0027Resultado Baseline\u0027).first().json.baseline_output || \u0027\u0027);\nconst optimized = String($(\u0027Resultado Maximum Savings\u0027).first().json.optimized_output || \u0027\u0027);\nconst expected = [\"LEAD-1980\",\"Campinas/SP\",\"R$ 850.000,00\",\"05/08/2026 14:30\",\"false\"];\nconst normalize = (value) =\u003e String(value || \u0027\u0027).normalize(\u0027NFD\u0027).replace(/[\\u0300-\\u036f]/g, \u0027\u0027).toLowerCase();\nconst factsPreserved = expected.every((fact) =\u003e normalize(baseline).includes(normalize(fact)) \u0026\u0026 normalize(optimized).includes(normalize(fact)));\nreturn [{ json: {\n  output: [\n    \u0027## Maximum Savings — prova real\u0027,\n    \u0027**Provider:** \u0027 + savings.before + \u0027 → \u0027 + savings.after + \u0027 tokens (\u0027 + savings.percent + \u0027%)\u0027,\n    \u0027**Conteúdo elegível:** \u0027 + optimization.eligibleTokensBefore + \u0027 → \u0027 + optimization.eligibleTokensAfter + \u0027 tokens (\u0027 + optimization.eligibleSavingsPercent + \u0027%)\u0027,\n    \u0027**Recuperação exata exigida:** \u0027 + String(optimization.retrievalRequired),\n    \u0027**Meta 70–90% atingida:** \u0027 + String(optimization.targetBandReached),\n    \u0027**5/5 fatos preservados:** \u0027 + String(factsPreserved)\n  ].join(\u0027\\n\u0027),\n  baselineOutput: baseline,\n  optimizedOutput: optimized,\n  providerSavings: savings,\n  eligibleSavings: {\n    before: optimization.eligibleTokensBefore,\n    after: optimization.eligibleTokensAfter,\n    percent: optimization.eligibleSavingsPercent,\n    targetBandReached: optimization.targetBandReached,\n    retrievalRequired: optimization.retrievalRequired,\n    resources: optimization.virtualizedResourceIds,\n    fallbackReason: optimization.targetNotReachedReason || null,\n    storageFallbackUsed: optimization.storageFallbackUsed\n  },\n  factsPreserved,\n  outputsMatch: baseline === optimized,\n  datasetRecords: 100,\n  targetIndex: 80,\n  model: \u0027models/gemini-2.5-flash\u0027,\n  measurement: \u0027provider\u0027\n} }];"
