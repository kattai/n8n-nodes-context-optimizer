{
  "name": "[LAB] Context Saver v2 — JSON recuperável",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "content": "## Context Saver v2 — teste sem API externa de dados\n\n1. Gera 120 registros localmente.\n2. Savings envia apenas um preview relevante.\n3. O original fica recuperável por resourceId.\n4. O agente busca exatamente `records[80]`.\n5. Metrics mostra economia elegível, total e líquida.\n\nConfigure somente a credencial do modelo Gemini antes de executar.",
        "height": 520,
        "width": 1780,
        "color": 5
      },
      "id": "note-context-saver-v2",
      "name": "Como testar",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-760, -400]
    },
    {
      "parameters": {},
      "id": "manual-trigger-v2",
      "name": "Executar teste",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-640, 0]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const records = Array.from({ length: 120 }, (_, index) => ({\n  id: 'ORDER-' + String(index).padStart(3, '0'),\n  status: index % 4 === 0 ? 'pending' : 'approved',\n  amount: 500000 + index * 1250,\n  region: 'region-' + (index % 12),\n  note: 'Contexto operacional repetido que deve permanecer recuperável.'\n}));\nreturn [{ json: { content: JSON.stringify({ source: 'local-demo', records }), expected: records[80] } }];"
      },
      "id": "generate-json-v2",
      "name": "Gerar JSON grande",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-400, 0]
    },
    {
      "parameters": {
        "operation": "optimizeContent",
        "content": "={{ $json.content }}",
        "contentType": "json",
        "currentTask": "Recuperar exatamente o registro ORDER-080",
        "protectedValues": "ORDER-080",
        "profile": "savings",
        "virtualizationMode": "required",
        "virtualizationOptionsV2": {
          "scope": "context-saver-v2-demo",
          "ttlHours": 1
        },
        "outputDetail": "simple"
      },
      "id": "context-content-v2",
      "name": "Context Saver Content — Savings",
      "type": "n8n-nodes-context-optimizer.contextOptimizer",
      "typeVersion": 2,
      "position": [-160, 0]
    },
    {
      "parameters": {
        "operation": "analyze",
        "metrics": "={{ $json }}",
        "outputDetail": "simple"
      },
      "id": "context-metrics-v2",
