                                         "description":  "Obrigatória. Retorna a base completa de leads. Use uma vez e localize o lead_identifier solicitado.",
                                         "language":  "javaScript",
                                         "jsCode":  "const records = [];\nfor (let index = 0; index \u003c 240; index += 1) {\n  const numericId = 1900 + index;\n  const target = numericId === 2048;\n  records.push({\n    lead_identifier: \u0027LEAD-\u0027 + numericId,\n    contact_full_name: target ? \u0027Marina Oliveira\u0027 : \u0027Lead Demonstração \u0027 + numericId,\n    contact_email_address: target ? \u0027marina.oliveira@example.com\u0027 : \u0027lead\u0027 + numericId + \u0027@example.com\u0027,\n    franchise_city_of_interest: target ? \u0027Campinas/SP\u0027 : [\u0027Curitiba/PR\u0027, \u0027Goiânia/GO\u0027, \u0027Londrina/PR\u0027, \u0027Sorocaba/SP\u0027][index % 4],\n    declared_available_investment_capital: target ? \u0027R$ 850.000,00\u0027 : \u0027R$ \u0027 + (450000 + (index % 8) * 50000).toLocaleString(\u0027pt-BR\u0027) + \u0027,00\u0027,\n    commercial_pipeline_stage: [\u0027Novo lead\u0027, \u0027Qualificação\u0027, \u0027Reunião pendente\u0027][index % 3],\n    acquisition_source_channel: [\u0027Site institucional\u0027, \u0027Landing page\u0027, \u0027Indicação\u0027][index % 3],\n    franchise_interest_temperature: [\u0027alto\u0027, \u0027médio\u0027, \u0027em avaliação\u0027][index % 3],\n    scheduled_expansion_meeting: target ? \u002705/08/2026 14:30\u0027 : null,\n    eligibility_approved: target ? false : index % 5 !== 0,\n    responsible_expansion_team: \u0027Expansão Casa do Construtor\u0027,\n    operational_follow_up_note: \u0027Confirmar somente os dados presentes neste registro; não inferir cidade, capital, data, horário ou aprovação.\u0027,\n    record_created_at: \u00272026-07-\u0027 + String((index % 28) + 1).padStart(2, \u00270\u0027) + \u0027T09:00:00-03:00\u0027\n  });\n}\nreturn JSON.stringify({\n  dataset_name: \u0027Leads de expansão — laboratório local\u0027,\n  query_received: query,\n  total_records: records.length,\n  records\n});",
                                         "specifyInputSchema":  true,
