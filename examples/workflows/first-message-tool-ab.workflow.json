                      "id":  "token-savings",
                      "name":  "Token Savings — Comparar Uso Real",
                      "type":  "n8n-nodes-context-optimizer.contextSaver",
                      "typeVersion":  3,
                      "position":  [
                                       1800,
                                       -64
                                   ]
                  },
                  {
                      "parameters":  {
                                         "mode":  "runOnceForAllItems",
                                         "language":  "javaScript",
                                         "jsCode":  "const savings = $input.first().json.tokenSavings || {};\nconst baseline = String($(\u0027Resultado Baseline\u0027).first().json.baseline_output || \u0027\u0027);\nconst optimized = String($(\u0027Resultado Otimizado\u0027).first().json.optimized_output || \u0027\u0027);\nconst expected = [\"LEAD-2048\",\"Campinas/SP\",\"R$ 850.000,00\",\"05/08/2026 14:30\",\"false\"];\nconst normalize = (value) =\u003e String(value || \u0027\u0027).normalize(\u0027NFD\u0027).replace(/[\\u0300-\\u036f]/g, \u0027\u0027).toLowerCase();\nconst baselineNormalized = normalize(baseline);\nconst optimizedNormalized = normalize(optimized);\nconst factsPreserved = expected.every((fact) =\u003e {\n  const normalized = normalize(fact);\n  return baselineNormalized.includes(normalized) \u0026\u0026 optimizedNormalized.includes(normalized);\n});\nconst format = (value) =\u003e Number.isFinite(Number(value)) ? Number(value).toLocaleString(\u0027pt-BR\u0027) : \u0027indisponível\u0027;\nconst percentage = Number.isFinite(Number(savings.percent)) ? Number(savings.percent).toLocaleString(\u0027pt-BR\u0027, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + \u0027%\u0027 : \u0027indisponível\u0027;\nconst output = [\n  \u0027## Baseline — sem otimização\u0027,\n  baseline,\n  \u0027\u0027,\n  \u0027## Otimizado — Token Saver Balanced\u0027,\n  optimized,\n  \u0027\u0027,\n  \u0027## Prova da primeira mensagem\u0027,\n  \u0027**Tokens de entrada reais:** \u0027 + format(savings.before) + \u0027 → \u0027 + format(savings.after),\n  \u0027**Economia real:** \u0027 + format(savings.saved) + \u0027 tokens (\u0027 + percentage + \u0027)\u0027,\n  \u0027**Medição:** \u0027 + String(savings.measurement || \u0027indisponível\u0027),\n  \u0027**5/5 fatos preservados:** \u0027 + (factsPreserved ? \u0027sim\u0027 : \u0027não\u0027),\n  \u0027**Mesma pergunta, tool, modelo e temperatura:** sim\u0027,\n].join(\u0027\\n\u0027);\nreturn [{ json: {\n  output,\n  baseline_output: baseline,\n  optimized_output: optimized,\n  token_savings: savings,\n  facts_preserved: factsPreserved,\n  first_message_test: true,\n  dataset_records: 240,\n  model: \u0027models/gemini-2.5-flash\u0027\n} }];"
                                     },
