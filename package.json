{
	"name": "n8n-nodes-context-optimizer",
	"version": "1.0.1",
	"description": "Provider-neutral n8n nodes that reduce AI Agent input tokens with quality guards and exact retrieval.",
	"license": "MIT",
	"homepage": "https://github.com/kattai/n8n-nodes-context-optimizer",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Casa do Construtor",
		"email": "automacoes@casadoconstrutor.com.br"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kattai/n8n-nodes-context-optimizer.git"
	},
	"scripts": {
		"build": "n8n-node build && tsc --build --force",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "vitest run --root .",
		"test:watch": "vitest --root .",
		"benchmark:cache": "npm run build && node scripts/run-cache-aware-benchmark.mjs",
		"benchmark:profiles": "npm run build && node scripts/run-profile-v2-benchmark.mjs",
		"benchmark:v0.8": "npm run build && node scripts/run-v0.8-benchmark.mjs",
		"benchmark:v0.9": "npm run build && node scripts/run-v0.9-benchmark.mjs",
		"benchmark:v1": "npm run build && node scripts/run-v1-boss-benchmark.mjs",
		"benchmark:regression": "npm run benchmark:profiles && npm run benchmark:v1",
		"check": "npm run test && npm run build && npm run lint",
		"check:local": "npm run test && npm run benchmark:regression && npm run lint",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist/**/*.d.ts",
		"dist/**/*.js",
		"dist/**/*.json",
		"dist/**/*.map",
		"dist/**/*.svg"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": false,
		"credentials": [
			"dist/credentials/ContextSaverStorageApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/ContextSaver/ContextSaver.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@types/node": "^26.1.2",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"dependencies": {
		"@langchain/core": "1.1.34",
		"redis": "^5.12.1",
		"zod": "3.25.67"
	}
}
